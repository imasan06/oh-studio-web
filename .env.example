# Public URL of the site (used for metadata / social cards)
NEXT_PUBLIC_SITE_URL=https://ohestudio.com

# Where the render frames live. Default: /renders (public/renders). For production, a CDN bucket
# (e.g. Cloudflare R2) with the same folder structure: https://renders.ohestudio.com
NEXT_PUBLIC_RENDERS_URL=

# Contact form (https://resend.com). Without these the form shows the studio email instead.
RESEND_API_KEY=
CONTACT_TO=hola@ohestudio.com
CONTACT_FROM="OH ESTUDIO web <web@ohestudio.com>"
